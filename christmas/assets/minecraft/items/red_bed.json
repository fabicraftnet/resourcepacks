{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "cases": [
      {
        "when": "tonttu",
        "model": {
          "type": "minecraft:model",
          "model": "item/tonttu"
        }
      },
      {
        "when": "tonttu2",
        "model": {
          "type": "minecraft:model",
          "model": "item/tonttuvihree"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "item/red_bed"
    }
  }
}